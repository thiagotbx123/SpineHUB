# SpineHUB Master Credentials Template
# Copy to .env.master and fill in your tokens

# ============================================
# GITHUB
# ============================================
# Create at: https://github.com/settings/tokens
# Required scopes: repo, read:org, workflow
GITHUB_TOKEN=

# ============================================
# SLACK
# ============================================
# Bot Token: https://api.slack.com/apps > OAuth & Permissions
# Required scopes: channels:history, channels:read, users:read, chat:write
SLACK_BOT_TOKEN=xoxb-

# User Token (optional, for user-level actions)
SLACK_USER_TOKEN=xoxp-

# ============================================
# LINEAR
# ============================================
# Create at: https://linear.app/settings/api
LINEAR_API_KEY=lin_api_

# ============================================
# GOOGLE DRIVE
# ============================================
# Create at: https://console.cloud.google.com/apis/credentials
# Download JSON and set path
GOOGLE_CREDENTIALS_PATH=

# ============================================
# ANTHROPIC (Claude API)
# ============================================
# Create at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-

# ============================================
# SPINEHUB CONFIG
# ============================================
SPINEHUB_USER=
SPINEHUB_EMAIL=
SPINEHUB_DEFAULT_BRANCH=main
SPINEHUB_AUTO_PUSH=false
