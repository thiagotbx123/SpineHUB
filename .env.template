# ============================================
# TSA SpineHub Consolidation - Variaveis de Ambiente
# ============================================
#
# INSTRUCOES:
# 1. Copie este arquivo para .env
# 2. Preencha apenas os servicos que voce usa
# 3. NUNCA commite o arquivo .env
#
# ============================================

# === USUARIO ===
USER_NAME="Seu Nome"
USER_EMAIL="seu@email.com"

# === GIT ===
# (Geralmente configurado globalmente, nao precisa aqui)
# GIT_USER_NAME="Seu Nome"
# GIT_USER_EMAIL="seu@email.com"

# === SLACK ===
# Obtenha em: https://api.slack.com/apps > OAuth & Permissions
# SLACK_USER_TOKEN="xoxp-..."
# SLACK_USER_ID="U..."
# SLACK_WORKSPACE="nome-do-workspace"

# === LINEAR ===
# Obtenha em: https://linear.app/settings/api
# LINEAR_API_KEY="lin_api_..."
# LINEAR_TEAM="nome-do-time"

# === GOOGLE DRIVE ===
# Configure OAuth em: https://console.cloud.google.com
# GOOGLE_CLIENT_ID="..."
# GOOGLE_CLIENT_SECRET="..."
# GOOGLE_REFRESH_TOKEN="..."

# === GITHUB ===
# Obtenha em: https://github.com/settings/tokens
# GITHUB_TOKEN="ghp_..."

# === OUTROS ===
# Adicione outras variaveis conforme necessario
# CUSTOM_API_KEY="..."

# ============================================
# FIM DO TEMPLATE
# ============================================
