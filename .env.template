# ============================================
# TSA SpineHub Consolidation - Environment Variables
# ============================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in only the services you use
# 3. NEVER commit the .env file
#
# ============================================

# === USER ===
USER_NAME="Your Name"
USER_EMAIL="your@email.com"

# === GIT ===
# (Usually configured globally, not needed here)
# GIT_USER_NAME="Your Name"
# GIT_USER_EMAIL="your@email.com"

# === SLACK ===
# Get at: https://api.slack.com/apps > OAuth & Permissions
# SLACK_USER_TOKEN="xoxp-..."
# SLACK_USER_ID="U..."
# SLACK_WORKSPACE="workspace-name"

# === LINEAR ===
# Get at: https://linear.app/settings/api
# LINEAR_API_KEY="lin_api_..."
# LINEAR_TEAM="team-name"

# === GOOGLE DRIVE ===
# Configure OAuth at: https://console.cloud.google.com
# GOOGLE_CLIENT_ID="..."
# GOOGLE_CLIENT_SECRET="..."
# GOOGLE_REFRESH_TOKEN="..."

# === GITHUB ===
# Get at: https://github.com/settings/tokens
# GITHUB_TOKEN="ghp_..."

# === OTHERS ===
# Add other variables as needed
# CUSTOM_API_KEY="..."

# ============================================
# END OF TEMPLATE
# ============================================
