# Credentials and Secrets
.env
.env.*
!.env.template
*.pem
*.key
credentials.json
secrets.json
*_secret*
*_token*

# Sensitive Data
data/exports/
data/pii/
evidence/prints/
evidence/screenshots/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
ENV/
env/
.pytest_cache/
*.egg-info/
dist/
build/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Temporary
*.tmp
*.temp
temp/
tmp/

# Node (if applicable)
node_modules/
npm-debug.log

# Cache
.cache/
*.cache

# Jupyter (if applicable)
.ipynb_checkpoints/
